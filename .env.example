# ─────────────────────────────────────────────────────────────
#  GitPulse configuration — copy to .env and fill in
# ─────────────────────────────────────────────────────────────

# Telegram bot token from @BotFather (required)
BOT_TOKEN=123456789:AAAA-your-bot-token

# Public HTTPS base URL that points at this server (required)
PUBLIC_URL=https://gitpulse.example.com

# Domain Caddy should request a certificate for (docker-compose)
DOMAIN=gitpulse.example.com

# webhook (production) or polling (local development)
TELEGRAM_MODE=webhook

# Random string Telegram echoes back on every update (recommended)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=change-me

# Fernet key used to encrypt PATs and webhook secrets (required)
# Generate: python -m app.keygen
ENCRYPTION_KEY=

# PostgreSQL
POSTGRES_USER=gitpulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gitpulse
DATABASE_URL=postgresql+asyncpg://gitpulse:change-me@postgres:5432/gitpulse

# Comma-separated Telegram user IDs allowed to see /status details on the home panel
ADMIN_IDS=

# Optional: GitHub OAuth App client ID → enables "Login with GitHub" (device flow).
# Enable "Device flow" in the OAuth App settings.
GITHUB_OAUTH_CLIENT_ID=

# Optional: token used for public lookups (stats, images) when no user token exists
GITHUB_FALLBACK_TOKEN=

# Optional: self-hosted Local Bot API server (uploads up to 2 GB)
# TELEGRAM_API_BASE=http://telegram-bot-api:8081
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=

# Behaviour
PUSH_DEBOUNCE_SECONDS=6
REVIEW_DEBOUNCE_SECONDS=4
ARTIFACT_PATTERN=*.apk
MAX_ARTIFACT_MB=0
WORKER_CONCURRENCY=8
PANEL_TTL_HOURS=48
INPUT_TTL_MINUTES=15

# Logging
LOG_LEVEL=INFO
LOG_JSON=true
